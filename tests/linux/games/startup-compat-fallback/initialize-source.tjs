if (kirikiriz != false) throw "Unexpected krkrz API flag";
// SPDX-License-Identifier: AGPL-3.0-only
if (debugWindowEnabled != false) throw "Fallback debugger default mismatch";
debugWindowEnabled = true;
if (!debugWindowEnabled) throw "Fallback debugger flag must remain writable";
Debug.message("KIRIKINUX_STARTUP_COMPAT_COMPILED_FALLBACK_OK");
var regressionWindow = new Window();
regressionWindow.caption = "kirikinux fallback regression";
regressionWindow.width = 480;
regressionWindow.height = 300;
regressionWindow.visible = true;
